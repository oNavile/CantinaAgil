<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cv_produto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/margin_outer_medium"
    android:layout_marginVertical="@dimen/margin_outer_small"
    app:cardCornerRadius="@dimen/card_corner_radius"
    app:cardElevation="@dimen/card_elevation"
    app:cardUseCompatPadding="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/padding_medium">

        <!-- Foto do Produto -->
        <ImageView
            android:id="@+id/iv_produto_foto"
            android:layout_width="@dimen/prod_photo_size"
            android:layout_height="@dimen/prod_photo_size"
            android:background="@color/primary_light"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_cat_salgados"
            tools:tint="@color/primary" />

        <!-- Título do Item -->
        <TextView
            android:id="@+id/tv_produto_titulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_outer_medium"
            android:layout_marginEnd="@dimen/margin_outer_medium"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_size_body_large"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/btn_adicionar_produto"
            app:layout_constraintStart_toEndOf="@+id/iv_produto_foto"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="@string/prod_misto_quente" />

        <!-- Descrição Curta -->
        <TextView
            android:id="@+id/tv_produto_descricao"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_size_body"
            app:layout_constraintEnd_toEndOf="@+id/tv_produto_titulo"
            app:layout_constraintStart_toStartOf="@+id/tv_produto_titulo"
            app:layout_constraintTop_toBottomOf="@+id/tv_produto_titulo"
            tools:text="@string/desc_misto_quente" />

        <!-- Preço Formatado -->
        <TextView
            android:id="@+id/tv_produto_preco"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/primary_dark"
            android:textSize="@dimen/text_size_title"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@+id/tv_produto_titulo"
            app:layout_constraintTop_toBottomOf="@+id/tv_produto_descricao"
            tools:text="@string/price_misto_quente" />

        <!-- Botão de Inclusão "+" -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btn_adicionar_produto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/add_to_cart_desc"
            app:backgroundTint="@color/primary"
            app:fabSize="mini"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_add"
            app:tint="@color/text_on_primary" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
