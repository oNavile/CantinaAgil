<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    tools:context=".MainActivity">

    <!-- Cabeçalho Institucional -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/primary"
        android:elevation="8dp"
        android:padding="@dimen/padding_large"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Logo da Cantina -->
        <ImageView
            android:id="@+id/iv_logo"
            android:layout_width="@dimen/logo_width"
            android:layout_height="@dimen/logo_height"
            android:contentDescription="@null"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_logo"
            app:tint="@color/text_on_primary" />

        <!-- Título de Boas-Vindas -->
        <TextView
            android:id="@+id/tv_welcome_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_outer_medium"
            android:text="@string/welcome_title"
            android:textColor="@color/text_on_primary"
            android:textSize="@dimen/text_size_header"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@+id/iv_logo"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Subtítulo -->
        <TextView
            android:id="@+id/tv_welcome_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/welcome_subtitle"
            android:textColor="@color/primary_light"
            android:textSize="@dimen/text_size_body_large"
            app:layout_constraintStart_toStartOf="@+id/tv_welcome_title"
            app:layout_constraintTop_toBottomOf="@+id/tv_welcome_title" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Instrução de Fluxo -->
    <TextView
        android:id="@+id/tv_home_instruction"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/margin_outer_large"
        android:layout_marginTop="@dimen/margin_outer_large"
        android:gravity="center"
        android:text="@string/home_instruction"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_size_title"
        android:textStyle="italic"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cl_header" />

    <!-- RecyclerView de Categorias (Grid) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_categorias"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/margin_outer_medium"
        android:layout_marginTop="@dimen/margin_outer_medium"
        android:layout_marginBottom="@dimen/margin_outer_medium"
        android:scrollbars="vertical"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:spanCount="3"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_home_instruction"
        tools:listitem="@layout/item_categoria" />

    <!-- Botão Flutuante (FAB) de Acesso ao Carrinho -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_carrinho"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/margin_outer_large"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/cart_button_desc"
        app:backgroundTint="@color/accent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:srcCompat="@drawable/ic_cart"
        app:tint="@color/text_primary" />

</androidx.constraintlayout.widget.ConstraintLayout>
