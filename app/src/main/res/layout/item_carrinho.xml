<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cv_carrinho_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/margin_outer_medium"
    android:layout_marginVertical="@dimen/margin_outer_small"
    app:cardCornerRadius="@dimen/card_corner_radius"
    app:cardElevation="@dimen/card_elevation"
    app:cardUseCompatPadding="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/padding_medium">

        <!-- Nome do Item -->
        <TextView
            android:id="@+id/tv_carrinho_item_nome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_size_body_large"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/ll_quantidade_controle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="@string/prod_misto_quente" />

        <!-- Valor Unitário -->
        <TextView
            android:id="@+id/tv_carrinho_item_preco"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/primary_dark"
            android:textSize="@dimen/text_size_body"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_carrinho_item_nome"
            tools:text="@string/price_misto_quente" />

        <!-- Controle de Quantidade (botões [-] e [+] com contador central) -->
        <LinearLayout
            android:id="@+id/ll_quantidade_controle"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/quantity_btn_size"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="@+id/tv_carrinho_item_preco"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_carrinho_item_nome">

            <ImageButton
                android:id="@+id/btn_carrinho_diminuir"
                android:layout_width="@dimen/quantity_btn_size"
                android:layout_height="@dimen/quantity_btn_size"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/quantity_decrease_desc"
                app:srcCompat="@drawable/ic_remove" />

            <TextView
                android:id="@+id/tv_carrinho_quantidade"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_size_body_large"
                android:textStyle="bold"
                tools:text="@string/quantity_placeholder" />

            <ImageButton
                android:id="@+id/btn_carrinho_aumentar"
                android:layout_width="@dimen/quantity_btn_size"
                android:layout_height="@dimen/quantity_btn_size"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/quantity_increase_desc"
                app:srcCompat="@drawable/ic_add" />
        </LinearLayout>

        <!-- Divisor Interno do Item -->
        <View
            android:id="@+id/v_carrinho_divisor"
            android:layout_width="0dp"
            android:layout_height="@dimen/divider_height"
            android:layout_marginTop="12dp"
            android:background="@color/bg_divider"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_carrinho_item_preco" />

        <!-- Componente de Escolha Temporal (Opções de Retirada/Agendamento) -->
        <!-- O container pode ser ocultado via tools:visibility para itens prontos -->
        <LinearLayout
            android:id="@+id/ll_retirada_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/v_carrinho_divisor"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tv_carrinho_retirada_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_caption"
                android:textStyle="bold"
                android:text="Opção de Retirada (Pedidos Personalizados):" />

            <RadioGroup
                android:id="@+id/rg_opcao_retirada"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rb_retirar_agora"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:buttonTint="@color/primary"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_size_body"
                    android:text="@string/label_retirar_agora" />

                <RadioButton
                    android:id="@+id/rb_agendar_retirada"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="@color/primary"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_size_body"
                    android:text="@string/label_agendar_retirada" />
            </RadioGroup>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
