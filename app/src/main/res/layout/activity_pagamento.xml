<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    tools:context=".PagamentoActivity">

    <!-- Barra Superior -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_pagamento_toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/bg_card"
        android:elevation="4dp"
        android:padding="@dimen/padding_medium"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btn_voltar_pagamento"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back_desc"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_back"
            app:tint="@color/text_primary" />

        <TextView
            android:id="@+id/tv_pagamento_titulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_outer_medium"
            android:text="@string/payment_title"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_size_title_large"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/btn_voltar_pagamento"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Área Esquerda: Exibição Expandida do Valor + Alerta Dinheiro -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_pagamento_info"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="@dimen/padding_large"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/cl_pagamento_selecao"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cl_pagamento_toolbar">

        <!-- Card de Exibição Expandida do Valor Total -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cv_total_pagar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="@dimen/card_elevation"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/padding_large">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/payment_total_label"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_size_body" />

                <TextView
                    android:id="@+id/tv_pagamento_valor_total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/primary_dark"
                    android:textSize="@dimen/text_size_senha"
                    android:textStyle="bold"
                    tools:text="@string/price_total_val" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Alerta Institucional de Dinheiro (Container de Destaque / Alto Contraste) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cv_alerta_dinheiro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_outer_large"
            app:cardBackgroundColor="@color/alert_bg"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="2dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cv_total_pagar">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="@dimen/padding_medium">

                <!-- Ícone de Alerta -->
                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="@dimen/margin_outer_small"
                    android:contentDescription="@null"
                    app:srcCompat="@android:drawable/ic_dialog_alert"
                    app:tint="@color/alert_text" />

                <TextView
                    android:id="@+id/tv_alerta_dinheiro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/tv_alerta_dinheiro"
                    android:textColor="@color/alert_text"
                    android:textSize="@dimen/text_size_body"
                    android:textStyle="bold" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Área Direita: Contêiner de Seleção de Pagamento -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_pagamento_selecao"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="@dimen/padding_large"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/cl_pagamento_info"
        app:layout_constraintTop_toBottomOf="@+id/cl_pagamento_toolbar">

        <TextView
            android:id="@+id/tv_instrucao_pagamento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/payment_method_title"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_size_body_large"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <RadioGroup
            android:id="@+id/rg_pagamento_metodo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_outer_medium"
            app:layout_constraintTop_toBottomOf="@+id/tv_instrucao_pagamento">

            <!-- Opção PIX -->
            <RadioButton
                android:id="@+id/btn_pagar_pix"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/ic_logo"
                android:backgroundTint="@color/bg_card"
                android:buttonTint="@color/primary"
                android:checked="true"
                android:padding="@dimen/padding_small"
                android:text="@string/pay_pix"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_size_body" />

            <!-- Opção Débito -->
            <RadioButton
                android:id="@+id/btn_pagar_debito"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginBottom="12dp"
                android:backgroundTint="@color/bg_card"
                android:buttonTint="@color/primary"
                android:padding="@dimen/padding_small"
                android:text="@string/pay_card_debito"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_size_body" />

            <!-- Opção Voucher -->
            <RadioButton
                android:id="@+id/btn_pagar_voucher"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:backgroundTint="@color/bg_card"
                android:buttonTint="@color/primary"
                android:padding="@dimen/padding_small"
                android:text="@string/pay_voucher"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_size_body" />

        </RadioGroup>

        <!-- Botão Finalizar -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_confirmar_pagamento"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/primary"
            android:text="@string/btn_finish_order"
            android:textAllCaps="false"
            android:textColor="@color/text_on_primary"
            android:textSize="@dimen/text_size_body_large"
            android:textStyle="bold"
            app:cornerRadius="@dimen/button_corner_radius"
            app:layout_constraintTop_toBottomOf="@+id/rg_pagamento_metodo" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
